---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";

const layering = `schema defaults  <  defaults.yml  <  user config  <  repo .ci-doctor.yml  <  CI_DOCTOR_* env  <  CLI flags`;

const envExample = `# Nested keys use a double underscore:
export CI_DOCTOR_LLM__MODEL="qwen2.5-coder:32b"
export CI_DOCTOR_LLM__API_BASE="http://vllm.internal:8000/v1"
export CI_DOCTOR_CI="github"

# Secret-looking single-underscore vars (e.g. CI_DOCTOR_GITLAB_TOKEN) are
# referenced by NAME (token_env) and ignored by the config loader.`;

const inspect = `ci-doctor config           # the effective config, every layer merged
ci-doctor config --diff    # only what your file/env/flags change vs the defaults
ci-doctor config --schema  # the JSON Schema, for editors and CI validation
ci-doctor config --validate            # the setup dry run: config, registries, matchers; exit 1 on a problem
ci-doctor -f base.yml -f ci.yml config # repeatable, the rightmost file wins
# Output pages through $PAGER on a terminal; ci-doctor --plain config prints raw (as does piping).`;

const schemaComment = `# yaml-language-server: $schema=https://github.com/ci-doctor/ci-doctor/releases/latest/download/ci-doctor.schema.json
llm:
  model: qwen2.5-coder:32b`;

const full = `# .ci-doctor.yml — every knob, with defaults shown.
ci: github                       # which CI to read the run from (github | gitlab)
scm: null                        # which git host gets the note (defaults to "ci")

gitlab:
  base_url: https://gitlab.com   # default; override for a self-hosted instance
  api_version: v4
  token_env: CI_DOCTOR_GITLAB_TOKEN
  token_file: null               # e.g. /run/secrets/gitlab_token (wins over token_env)
  ca_bundle: null                # path to a custom/internal CA bundle
  verify_ssl: true
  timeout_seconds: 30

github:                          # used when github is the ci or the scm
  base_url: https://api.github.com     # default; override with a GHE base, e.g. https://ghe/api/v3
  token_env: CI_DOCTOR_GITHUB_TOKEN
  token_file: null
  ca_bundle: null
  verify_ssl: true
  timeout_seconds: 30

llm:
  enabled: true                  # false => deterministic-only report
  backend: openai                # openai | anthropic | azure | bedrock | bedrock-mantle | google |
                                 # google-cloud | groq | mistral | cohere | xai | huggingface
  model: null                    # e.g. "qwen2.5-coder:32b" or "claude-opus-4-8"
  api_base: null                 # OpenAI-compatible base URL
  api_key_env: null              # optional; local servers often need none
  openai:
    api: chat                    # backend: openai; chat (Chat Completions) | responses (Responses API)
  azure: null                    # backend: azure; required there
  #   endpoint: https://<resource>.openai.azure.com
  #   api_version: "2024-10-21"
  aws: null                      # bedrock, bedrock-mantle; required there
  #   region: us-east-1          # optional; falls back to AWS_DEFAULT_REGION/AWS_REGION
  gcp: null                      # backend: google-cloud; required there
  #   project: my-project        # optional; falls back to the environment's
  #   location: us-central1      # optional; e.g. us-central1 or global
  max_input_tokens: 12000
  temperature: 0.1
  timeout_seconds: 120           # wall-clock budget for one call, retries included
  max_retries: 1                 # SDK retries (not bedrock); Pydantic AI's own Agent retries once more on an invalid reply

analysis:
  include_allowed_failures: false   # allow_failure jobs are noise by default
  max_jobs_analyzed: 10
  max_parallel_jobs: 4              # jobs analyzed at once; 1 for a strictly sequential run
  skip_llm_for: [no_runner, missing_dependency, cancelled]  # fully-determined -> templated

phases:                          # section/step name -> phase (merged onto the shipped map)
  my_custom_deploy_section: script

matchers:
  registries:                    # alias -> registry folder (the one holding index.yaml)
    official: https://matchers.cidoc.dev/   # shipped; override it, or add your own:
    # acme: ./ci/matchers                   # a path, relative to this file
    # pinned: https://raw.githubusercontent.com/acme/matchers/<tag-or-sha>/
  include: []                    # alias/name of a matcher or bundle; empty exits 1
  # include: [official/python, acme/mytool]
  exclude: []                    # alias/matcher.output to drop; one that names nothing exits 1
  timeout_seconds: 10            # per registry request
  fetch_workers: 8               # registry files fetched at once; 1 fetches in order

extraction:
  tail_lines: 120                # lines kept from the end of the blamed section

denoise:
  collapse_carriage_returns: true   # collapse \\r progress bars to their final state
  dedupe_repeats: true              # repeated lines -> "<line>  (×47)"
  noise_patterns:
    - '^\\s*$'

output:
  terminal: true
  markdown_path: report.md
  json_path: report.json
  mr_note: false                 # post/update a note on the MR/PR (needs a live pipeline)

redaction:
  enabled: true
  extra_patterns: []             # additional regexes to scrub`;
---

<Base title="Configuration">
    <h1>Configuration</h1>
    <p class="lead">
        One layered, pydantic-validated config. Unknown keys are an error, not a
        silent typo.
    </p>

    <div class="note">
        This page is the reference — every key and its default. For what the
        keys
        <em>mean</em> — phases, attribution, denoising, matchers, budget, redaction
        — start with
        <a href={url("/concepts/")}>Concepts</a>. ci-doctor ships no matchers:
        browse what a registry offers on
        <a href="https://matchers.cidoc.dev">matchers.cidoc.dev</a>.
    </div>

    <h2>How layers combine</h2>
    <Code code={layering} lang="text" theme="github-dark" />
    <p>
        Mappings deep-merge; lists and scalars replace. So
        <code>matchers.registries</code>, a mapping, adds to the shipped
        <code>official</code> entry, while <code>matchers.include</code>, a list,
        replaces the one before it. A relative registry path resolves against the
        directory of the config file that names it; one set in an environment
        variable resolves against the working directory. Point at specific files with <code
            >ci-doctor -f path/to/.ci-doctor.yml</code
        >, before the command, repeated as often as you like — each one overrides the last.
    </p>
    <p>
        The user config applies to every repo on the machine:
        <code>~/.config/ci-doctor/config.yml</code> on Linux (or under
        <code>$XDG_CONFIG_HOME</code>), <code>~/Library/Application Support/ci-doctor/config.yml</code>
        on macOS, <code>%APPDATA%\ci-doctor\config.yml</code> on Windows. It is where
        <code>ci-doctor matchers add</code> and the other editing commands write;
        <code>ci-doctor --write-to .ci-doctor.yml matchers add …</code> edits the repo file instead.
    </p>

    <h2>Inspecting the result</h2>
    <p>Config bugs are almost always a layer you forgot was applied. Ask:</p>
    <Code code={inspect} lang="bash" theme="github-dark" />
    <p>
        <code>--diff</code> reads like <code>git diff</code>: green is what your
        config adds, red is the default it replaced.
    </p>

    <h2>Editor completion</h2>
    <p>
        Every release ships <code>ci-doctor.schema.json</code>, generated from
        the same pydantic model that validates your file, so it can never drift.
        Point your editor at it:
    </p>
    <Code code={schemaComment} lang="yaml" theme="github-dark" />

    <h2>Environment variables</h2>
    <Code code={envExample} lang="bash" theme="github-dark" />

    <h2>Custom CA certificates</h2>
    <p>
        ci-doctor has no CA setting for the LLM or the matcher registries: each client
        trusts what its environment says, the way <code>pip</code>, <code>uv</code> and
        <code>curl</code> do. Point <code>SSL_CERT_FILE</code> (or <code>SSL_CERT_DIR</code>)
        at a bundle holding your internal CA <em>and</em> the public roots, usually the
        system one, such as <code>/etc/ssl/certs/ca-certificates.crt</code>. That covers the
        registry fetches and every LLM SDK built on httpx. Bedrock reads
        <code>AWS_CA_BUNDLE</code> instead. The GitLab and GitHub clients keep their own
        <code>ca_bundle</code> / <code>verify_ssl</code> keys below.
    </p>

    <h2>LLM backends</h2>
    <p>
        The LLM step is bring-your-own, via <a href="https://ai.pydantic.dev/">Pydantic
        AI</a>. Pick one with <code>llm.backend</code>:
    </p>
    <table>
        <thead
            ><tr><th>backend</th><th>What it calls</th><th>Needs</th></tr
            ></thead
        >
        <tbody>
            <tr
                ><td><code>openai</code> (default)</td><td
                    >Any OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp,
                    internal gateway) or OpenAI itself</td
                ><td
                    ><code>model</code> + <code>api_base</code>; optionally
                    <code>openai.api: responses</code> for the Responses API
                    (default <code>chat</code>); <code
                        >pip install ci-doctorr[openai]</code
                    ></td
                ></tr
            >
            <tr
                ><td><code>anthropic</code></td><td
                    >The Anthropic Messages API directly</td
                ><td
                    ><code>model</code> + <code>api_key_env</code>; <code
                        >pip install ci-doctorr[anthropic]</code
                    ></td
                ></tr
            >
            <tr
                ><td><code>azure</code></td><td
                    >Azure OpenAI</td
                ><td
                    ><code>model</code>, <code>azure.endpoint</code>, <code>azure.api_version</code>, <code
                        >api_key_env</code
                    >; <code>pip install ci-doctorr[openai]</code></td
                ></tr
            >
            <tr
                ><td><code>bedrock</code></td><td
                    >Amazon Bedrock, AWS IAM auth (env vars, profile, or instance
                    role) — not an API key</td
                ><td
                    ><code>model</code>; <code>aws.region</code> or
                    <code>AWS_DEFAULT_REGION</code>; <code
                        >pip install ci-doctorr[bedrock]</code
                    ></td
                ></tr
            >
            <tr
                ><td><code>bedrock-mantle</code></td><td
                    >Bedrock's OpenAI-shaped models, AWS IAM auth</td
                ><td
                    ><code>model</code>; <code>aws</code> (<code>region</code> optional); <code>pip install ci-doctorr[bedrock-mantle]</code></td
                ></tr
            >
            <tr
                ><td><code>google</code></td><td
                    >The Gemini API</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>GOOGLE_API_KEY</code>; <code>pip install ci-doctorr[google]</code></td
                ></tr
            >
            <tr
                ><td><code>google-cloud</code></td><td
                    >Vertex AI, Google Cloud auth</td
                ><td
                    ><code>model</code>; <code>gcp.project</code>/<code>gcp.location</code> with Application Default Credentials, or an API key; <code>pip install ci-doctorr[google]</code></td
                ></tr
            >
            <tr
                ><td><code>groq</code></td><td
                    >Groq's own API</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>GROQ_API_KEY</code>; <code>pip install ci-doctorr[groq]</code></td
                ></tr
            >
            <tr
                ><td><code>mistral</code></td><td
                    >Mistral's own API</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>MISTRAL_API_KEY</code>; <code>pip install ci-doctorr[mistral]</code></td
                ></tr
            >
            <tr
                ><td><code>cohere</code></td><td
                    >Cohere's own API</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>CO_API_KEY</code>; <code>pip install ci-doctorr[cohere]</code></td
                ></tr
            >
            <tr
                ><td><code>xai</code></td><td
                    >xAI's Grok API</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>XAI_API_KEY</code>; <code>pip install ci-doctorr[xai]</code></td
                ></tr
            >
            <tr
                ><td><code>huggingface</code></td><td
                    >Hugging Face Inference</td
                ><td
                    ><code>model</code>; <code>api_key_env</code> or <code>HF_TOKEN</code>; <code>pip install ci-doctorr[huggingface]</code></td
                ></tr
            >
        </tbody>
    </table>
    <div class="note">
        <strong>Reach for <code>openai</code> first.</strong> The OpenAI Chat
        Completions shape is what Ollama, vLLM, llama.cpp, Together, Groq, DeepSeek,
        Mistral and most others already speak; a provider with its own backend above
        (Groq, Mistral, Google, ...) talks to its native API instead. Keep
        <code>openai.api</code> on <code>chat</code> for self-hosted servers; only
        OpenAI itself and some gateways offer the newer Responses API. There is no default SDK in the base
        install any more — every backend needs its own extra, picked for exactly the
        provider you're using.
    </div>
    <div class="note">
        <strong>Only Pydantic AI's own providers.</strong> Every backend is a provider
        <a href="https://ai.pydantic.dev/models/overview/">Pydantic AI</a> ships itself,
        so the extras install side by side. Pydantic AI supports more providers than the
        ones listed here; ask for one you need. When the LLM is disabled or unavailable,
        ci-doctor emits the deterministic report instead of failing.
    </div>
    <div class="note">
        <strong><code>bedrock</code> with no resolvable AWS credentials can probe
        the network at startup.</strong> Unlike the other backends, building the
        client eagerly resolves AWS credentials (env vars, profile, or instance
        metadata) — with none available anywhere, that resolution itself makes a
        request rather than failing instantly. Set <code>AWS_ACCESS_KEY_ID</code>/<code
            >AWS_SECRET_ACCESS_KEY</code
        > (or run with an instance role) so it never reaches that path.
    </div>

    <h2>Matchers</h2>
    <p>
        Evidence matchers are not written in this file. They live in registries,
        and the config only says where those are and what to load from them:
    </p>
    <table>
        <thead><tr><th>Key</th><th>Default</th><th>What it does</th></tr></thead>
        <tbody>
            <tr
                ><td><code>matchers.registries</code></td><td
                    ><code>{"{official: https://matchers.cidoc.dev/}"}</code></td
                ><td
                    >Alias → the folder holding the registry's <code
                        >index.yaml</code
                    >. An alias is lowercase letters, digits, <code>_</code> and
                    <code>-</code>. Locations are listed below.</td
                ></tr
            >
            <tr
                ><td><code>matchers.include</code></td><td><code>[]</code></td><td
                    >Matchers and bundles to load, each <code>alias/name</code>.
                    Nothing is selected by default, and an empty list exits 1.</td
                ></tr
            >
            <tr
                ><td><code>matchers.exclude</code></td><td><code>[]</code></td><td
                    >Outputs to drop from the included matchers, each
                    <code>alias/matcher.output</code> (<code>official/ruff.format</code>).
                    An entry that names no output of an included matcher exits 1.</td
                ></tr
            >
            <tr
                ><td><code>matchers.timeout_seconds</code></td><td><code>10</code></td><td
                    >Seconds to wait on each registry request before failing the
                    setup. Raise it for a slow mirror.</td
                ></tr
            >
            <tr
                ><td><code>matchers.fetch_workers</code></td><td><code>8</code></td><td
                    >Registry files fetched at once, 1–32. Lower it for a registry
                    that rate-limits.</td
                ></tr
            >
        </tbody>
    </table>
    <table>
        <thead><tr><th>Location</th><th>Example</th></tr></thead>
        <tbody>
            <tr
                ><td>A local path, relative to the config file</td><td
                    ><code>./ci/matchers</code></td
                ></tr
            >
            <tr><td><code>file://</code></td><td><code>file:///srv/matchers</code></td></tr>
            <tr
                ><td><code>https://</code> (<code>http://</code> works, with a
                    warning)</td
                ><td><code>https://matchers.cidoc.dev/</code></td></tr
            >
        </tbody>
    </table>
    <p>
        Every run reads the registries as they are now: there is no cache, no
        lock file and no version field. To pin one, point it at a URL that
        contains a fixed revision, such as a raw URL with a tag or commit SHA in
        it. Edit both keys by hand or with
        <a href={url("/reference/cli/")}><code>ci-doctor matchers</code></a>, and
        check the result with <code>ci-doctor config --validate</code>.
    </p>

    <h2>Regex syntax</h2>
    <p>
        Every regex you can configure — a matcher's <code>regex</code> (and the
        regex a <code>template</code> becomes),
        <code>denoise.noise_patterns</code>, <code>redaction.extra_patterns</code> —
        is <a href="https://github.com/google/re2/wiki/Syntax">RE2</a>, compiled when
        the config loads. RE2 matches in linear time, so no pattern can hang a job.
        What that rules out:
    </p>
    <ul>
        <li>No lookaround (<code>(?=</code>, <code>(?!</code>, <code>(?&lt;=</code>,
            <code>(?&lt;!</code>) — on a matcher, list the lines to reject under
            <code>exclude</code>.</li>
        <li>No backreferences (<code>\1</code>), and <code>\z</code> rather than <code>\Z</code>.</li>
        <li>Repeats of at most 1000 (<code>{"a{1001}"}</code> is rejected).</li>
        <li><code>\d \s \w \b</code> are ASCII-only. Use <code>{"\\p{Nd}"}</code> or
            <code>{"\\p{L}"}</code> for Unicode.</li>
    </ul>

    <h2>Full reference</h2>
    <p>
        Drop a <code>.ci-doctor.yml</code> at your repo root. Everything below is
        optional — every key has a default.
    </p>
    <Code code={full} lang="yaml" theme="github-dark" />

    <div class="note">
        <strong><code>base_url</code> defaults to the public host</strong> (<code
            >gitlab.com</code
        > /
        <code>api.github.com</code>). Override it for a self-hosted GitLab or
        GitHub Enterprise instance. Custom CA bundles and proxies are honoured
        either way.
    </div>
</Base>
