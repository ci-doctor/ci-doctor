---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";

const cli = `ci-doctor [-f PATH]... analyze [OPTIONS] [TARGET]

Global options (before the command, for every command):
  -f, --config PATH      Path to a .ci-doctor.yml. Repeatable — later files
                         override earlier ones.
  --plain                Bare text for scripts: no tables, no colour, no pager.
  --no-color             Disable coloured output (also honours NO_COLOR).
  -v, --verbose          Enable debug logging.

Arguments:
  TARGET                 Pipeline/run id, or the path to a raw job log to replay
                         offline (an existing path means no run is fetched).

Options:
  --job-id TEXT          Analyze a single job id.
  --format [terminal|json]
                         stdout format. \`json\` prints the report instead of the
                         rendered panels. [default: terminal]
  --help                 Show this message and exit.`;

const jsonOut = `# Everything a script or a coding agent needs, on stdout:
ci-doctor analyze --format json "$CI_PIPELINE_ID" | jq '.[0].handoff_prompt'

# Logs and progress go to stderr, so the pipe only ever carries the report.
# report.md and report.json are still written as artifacts either way.`;

const configCmd = `ci-doctor config           # the effective config, every layer merged
ci-doctor config --diff    # only what your file/env/flags change vs the defaults
ci-doctor config --schema  # the JSON Schema, for editors and CI validation
ci-doctor config --validate  # the setup dry run: exit 1 on what analyze would refuse`;

const validateOut = `$ ci-doctor config --validate
config ok: ci=gitlab, scm=gitlab, 23 matchers from 1 registries.`;

const matchersUse = `ci-doctor matchers add ALIAS/NAME...      # append to matchers.include
ci-doctor matchers remove ALIAS/NAME...   # drop entries from matchers.include
ci-doctor matchers list                   # what include resolves to, and via which bundle
ci-doctor matchers search TERM [--registry ALIAS]
ci-doctor matchers info ALIAS/NAME        # description, tags, each output's role, registry, path; a bundle's members
ci-doctor matchers examine MATCHER LOG [--framing github|gitlab|plain]  # what each output selects from LOG

ci-doctor matchers registry add NAME=LOCATION...  # add or override, after fetching its index.yaml
ci-doctor matchers registry remove NAME...        # refused while include still uses it
ci-doctor matchers registry list
ci-doctor matchers registry ping [NAME...]        # reachability, latency, matcher and bundle count

ci-doctor matchers pull [ALIAS/NAME...]  # fetch into the cache without analysing; include when omitted
ci-doctor matchers mirror NAME DIR       # copy a whole registry, hash-checked, to serve or use as a path

ci-doctor matchers cache info    # where the cache is, its size, each registry's index age and files cached
ci-doctor matchers cache prune   # delete files no cached index lists (old versions of changed matchers)
ci-doctor matchers cache clean   # delete everything; the next run fetches every file again

# The global ci-doctor -f PATH adds config files to read. The commands that edit the
# config write your user config (~/.config/ci-doctor/config.yml on Linux), created if
# missing; ci-doctor --write-to FILE matchers ... writes FILE instead, and reads it too.
# Output is a table by default; ci-doctor --plain matchers ... prints one bare line per row.`;

const matchersAuthor = `ci-doctor matchers index [ROOT] [--check]    # validate, then write index.yaml and the ecosystem bundles
ci-doctor matchers verify [ROOT] [--update] [--min-positive N] [--min-negative N]
                          [--exempt FILE] [--cross-fire] [--json FILE]
ci-doctor matchers schema [--version N | --out DIR]  # a matcher file's JSON Schema; --out writes every version`;

const deterministic = `# Deterministic report, no model required:
ci-doctor --config .ci-doctor.yml analyze "$CI_PIPELINE_ID"
#   with llm.enabled: false (or llm.model/api_base unset)

# It prints the verdict, writes report.md + report.json, and (if configured
# and confidence >= medium) posts/updates one idempotent MR/PR note.`;

const verbose = `ci-doctor -v analyze failing-job.log

ci-doctor [DEBUG] ci=gitlab scm=gitlab target=failing-job.log ...
ci-doctor [DEBUG] job failing-job: 6 top-level sections
ci-doctor [DEBUG] job failing-job: attribution phase=script reason=script_failure rule=trailer_exit_code confidence=high
ci-doctor [DEBUG] blamed phase script: denoise 812->190, extract ->140, fit ->140 lines (truncated=False)
ci-doctor [DEBUG] LLM disabled/unconfigured -> deterministic report`;
---

<Base
    title="CLI"
    description="The ci-doctor command line: analyze, config and matchers, their flags, exit codes, and what --verbose prints."
>
    <h1>CLI</h1>
    <p class="lead">
        Three commands: <code>analyze</code>, <code>config</code> and
        <code>matchers</code>. A broken setup exits 1; once analysis starts,
        the exit code is always 0.
    </p>

    <h2>Exit codes</h2>
    <table>
        <thead><tr><th>Exit</th><th>When</th></tr></thead>
        <tbody>
            <tr
                ><td><code>1</code></td><td
                    >A broken setup, caught before analysis starts: an invalid or
                    missing config file, an empty <code>matchers.include</code>, an
                    unknown registry or name, a registry that cannot be reached or
                    serves an invalid file, bad CLI usage, a missing log file. Also
                    any failure of a command other than <code>analyze</code>
                    (<code>matchers</code>, <code>config</code>, <code>report</code>),
                    a crash included.</td
                ></tr
            >
            <tr
                ><td><code>0</code></td><td
                    >Everything else. Once <code>analyze</code> starts, an API error,
                    an LLM failure or a crash still exits 0, so the analyzer never changes
                    a pipeline's outcome.</td
                ></tr
            >
        </tbody>
    </table>

    <h2><code>analyze</code></h2>
    <Code code={cli} lang="text" theme="github-dark" />
    <p>
        What the report looks like is on <a href={url("/start/first-run/")}
            >First run</a
        >.
    </p>

    <h2>Machine-readable output</h2>
    <p>
        <code>--format json</code> puts the report on stdout instead of the
        rendered panels — the same array that lands in <code>report.json</code>,
        matching the schema on <a href={url("/concepts/evidence/")}>Evidence</a>.
        Everything else the command says goes to stderr, so the pipe carries the
        report and nothing else.
    </p>
    <Code code={jsonOut} lang="bash" theme="github-dark" />

    <h2>Deterministic mode (no LLM)</h2>
    <Code code={deterministic} lang="bash" theme="github-dark" />

    <h2>Inspecting your config</h2>
    <p>
        Config surprises are almost always a layer you forgot was applied. Ask,
        rather than guess — the full layering rules are on <a
            href={url("/reference/configuration/")}>Configuration</a
        >:
    </p>
    <Code code={configCmd} lang="bash" theme="github-dark" />
    <p>
        <code>--validate</code> runs every setup step <code>analyze</code> takes
        before analysis: it loads the config, then resolves, fetches and validates
        every selected matcher. It exits 1 on the first problem, so it is the step
        to run when you change <code>matchers:</code>:
    </p>
    <Code code={validateOut} lang="text" theme="github-dark" />

    <h2><code>matchers</code></h2>
    <p>
        Selects matchers and manages the registries they come from. How
        registries and <code>alias/name</code> refs work is on <a
            href={url("/concepts/matchers/")}>Matchers</a
        >.
    </p>
    <Code code={matchersUse} lang="text" theme="github-dark" />
    <p>
        Commands that change the config touch only its <code>matchers:</code>
        block, and fetch before they write: an unknown registry or name exits 1
        and leaves the file as it was. <code>add</code> skips a ref that is already
        included, directly or through a bundle. <code>remove</code> drops only
        entries written in <code>include</code>; to drop a matcher that came in
        through a bundle, remove the bundle; to drop one output of a matcher, list
        it under <code>matchers.exclude</code>. Removing an override of
        <code>official</code> falls back to its default address.
    </p>
    <p>
        <code>search</code>, <code>info</code>, <code>add</code> and
        <code>examine</code> read registries through the same cache as
        <code>analyze</code>; <code>registry ping</code> never does, since it is
        there to test the registry. <code>pull</code> warms the cache ahead of a
        run (a Docker build, a CI setup step). <code>mirror</code> writes every
        file a registry serves into <code>DIR</code>, the index last, after every
        file has passed its hash check; <code>DIR</code> must be empty, missing, or
        an earlier mirror. How the cache works is on <a
            href={url("/concepts/matchers/")}>Matchers</a
        >.
    </p>
    <p>
        <code>examine</code> runs one matcher, a <code>matcher.yaml</code> or an
        <code>alias/name</code>, over one log with the same engine
        <code>analyze</code> uses. A <code>.github.log</code> or
        <code>.gitlab.log</code> has that runner's framing stripped; anything else
        is read as plain unless <code>--framing</code> says otherwise. It prints
        each output's selection, <code>&gt;</code> on every anchor, with the
        variants that fired, and exits 0 even when nothing matches.
    </p>
    <p>
        Two commands are for registry authors, run in the registry's own CI.
        <code>ROOT</code> is the registry folder and defaults to the current
        directory:
    </p>
    <Code code={matchersAuthor} lang="text" theme="github-dark" />
    <p>
        <code>index --check</code> writes nothing and exits 1 when the committed
        <code>index.yaml</code> or a generated ecosystem bundle is stale.
        <code>verify</code> exits 1 when an output's selection differs from its
        <code>.expected</code> file, a variant is proven by no fixture, an output
        fires on a runner's own "job failed" line, or an output has fewer fixtures
        than <code>--min-positive</code> / <code>--min-negative</code> (3 and 2 by
        default; <code>--exempt</code> names a file of matchers held to one).
        <code>--cross-fire</code> also fails on an output firing on another
        matcher's fixture, and <code>--json</code> writes the whole report.
        <code>--update</code> rewrites the <code>.expected</code> files for review.
        Writing a registry is on <a href={url("/reference/registry/")}>Hosting a registry</a>.
    </p>

    <h2>Reporting a bug</h2>
    <p>
        <code>ci-doctor report</code> prints what an issue needs: the ci-doctor, Python and
        dependency versions, the installed LLM SDKs, the platform, a summary of the config,
        and which proxy and CA variables are set. Paste it into the issue. It holds no
        secrets: environment variables show as set or unset, and config files and
        endpoints are named, not shown. Pass the same <code>-f</code> files you run with.
    </p>

    <h2>Debugging with <code>--verbose</code></h2>
    <p>
        Turn on debug logs across the whole pipeline (or set <code
            >CI_DOCTOR_LOG_LEVEL=DEBUG</code
        >):
    </p>
    <Code code={verbose} lang="text" theme="github-dark" />
    <p>
        The <code>denoise → extract → fit</code> line is the one to read when the
        evidence looks wrong: it shows how many lines each stage kept, and whether
        the token budget had to truncate.
    </p>

    <div class="note">
        <strong>Offline replay.</strong> Passing a log path instead of a run id runs
        the full pipeline against a captured log without the CI provider, and
        without an LLM when none is configured. The selected matchers are still
        read from their registries, so point <code>matchers.registries</code> at a
        local folder to replay with no network at all.
    </div>
</Base>
