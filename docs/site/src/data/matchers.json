[
  {
    "group": "Python",
    "packs": [
      {
        "id": "pytest",
        "kind": "block",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^=+ FAILURES =+",
        "end": "^=+ short test summary",
        "before": 0,
        "after": 0,
        "note": "pytest's `=== FAILURES ===` block, from the first failing test through to the short summary."
      },
      {
        "id": "python_traceback",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "^\\s*Traceback \\(most recent call last\\):",
        "end": "",
        "before": 1,
        "after": 25,
        "note": "An uncaught Python exception. The exception type and message are on the traceback's last line; the frames above show where it was raised."
      },
      {
        "id": "python_lint",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "lint"
        ],
        "match": "^\\S+\\.py:\\d+:(\\d+:)? (error|[EFWCN]\\d+)",
        "end": "",
        "before": 0,
        "after": 3,
        "note": "A `file.py:12: error` diagnostic from mypy, ruff, flake8 or pylint."
      }
    ]
  },
  {
    "group": "JavaScript / TypeScript",
    "packs": [
      {
        "id": "jest",
        "kind": "block",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^\\s*\u25cf|^FAIL\\s+\\S+\\.(test|spec)\\.[jt]sx?\\b",
        "end": "^Tests:",
        "before": 0,
        "after": 0,
        "note": "A jest test failure \u2014 the `\u25cf` header names the test, and the diff below it shows expected against received."
      },
      {
        "id": "tsc",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "build"
        ],
        "match": "error TS\\d+:",
        "end": "",
        "before": 1,
        "after": 3,
        "note": "A TypeScript compile error (`error TS2345:`) with the source excerpt around it."
      },
      {
        "id": "eslint",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "lint"
        ],
        "match": "^\\s*\\d+:\\d+\\s+error\\s+|\u2716 \\d+ problems?",
        "end": "",
        "before": 2,
        "after": 6,
        "note": "ESLint's `line:col error rule-name` entries and its `\u2716 N problems` footer."
      },
      {
        "id": "pnpm",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "deps"
        ],
        "match": "ERR_PNPM_\\w+",
        "end": "",
        "before": 1,
        "after": 10,
        "note": "pnpm's `ERR_PNPM_*` codes \u2014 the resolver or lockfile refusing, which is the cause itself."
      },
      {
        "id": "yarn",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "deps"
        ],
        "match": "^error [A-Z]|\u27a4 YN\\d{4}",
        "end": "",
        "before": 1,
        "after": 8,
        "note": "Yarn Classic's `error <Capital>` lines and Berry's `\u27a4 YN####:` diagnostic codes."
      },
      {
        "id": "bun",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "test",
          "deps"
        ],
        "match": "error: No version matching|^\\s*\u2717 |^\\s*\\d+ fail\\b",
        "end": "",
        "before": 2,
        "after": 12,
        "note": "A failed `bun test` (the `\u2717` test and its assertion), or a `bun install` that found no matching version."
      },
      {
        "id": "node_runtime",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "^\\s*at .+\\(node:internal|^Node\\.js v\\d+\\.|ERR_MODULE_NOT_FOUND|ERR_REQUIRE_ESM|UnhandledPromiseRejection",
        "end": "",
        "before": 12,
        "after": 6,
        "note": "An uncaught Node error. The message above the stack is the cause; an ESM/CJS resolution error means a missing or mis-declared module."
      },
      {
        "id": "playwright",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "e2e"
        ],
        "match": "^\\s*\\d+\\) .+ \u203a ",
        "end": "",
        "before": 0,
        "after": 20,
        "note": "A Playwright test failure \u2014 the `1) suite \u203a test` header names the test; its trace and diff follow."
      },
      {
        "id": "cypress",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "e2e"
        ],
        "match": "CypressError|Timed out retrying after \\d+ms",
        "end": "",
        "before": 3,
        "after": 12,
        "note": "A `CypressError` or a retry timeout, with the command log leading up to it."
      },
      {
        "id": "npm",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [
          "deps"
        ],
        "match": "npm ERR!",
        "end": "",
        "before": 2,
        "after": 10,
        "note": "`npm ERR!` lines. A wrapper: npm reports the failure of the script it ran, never the cause."
      },
      {
        "id": "js_script_exit",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [],
        "match": "^\\s*ELIFECYCLE\\b|error: script \".+\" exited with code",
        "end": "",
        "before": 1,
        "after": 4,
        "note": "A JS package manager announcing that a lifecycle script exited non-zero \u2014 pnpm's `ELIFECYCLE`, bun's `error: script \"x\" exited with code N`."
      }
    ]
  },
  {
    "group": "Go",
    "packs": [
      {
        "id": "go_test",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^--- FAIL",
        "end": "",
        "before": 2,
        "after": 15,
        "note": "`go test`'s per-test `--- FAIL` marker, plus the assertion output printed under it."
      },
      {
        "id": "go_panic",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "^panic: |^fatal error: ",
        "end": "",
        "before": 2,
        "after": 20,
        "note": "A Go `panic:` or runtime `fatal error:` with the goroutine dump beneath it."
      }
    ]
  },
  {
    "group": "Rust",
    "packs": [
      {
        "id": "rust_test",
        "kind": "block",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^failures:$",
        "end": "^test result:",
        "before": 0,
        "after": 0,
        "note": "`cargo test`'s `failures:` block through to the `test result:` line."
      },
      {
        "id": "rust_panic",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "^thread '.*' panicked at",
        "end": "",
        "before": 2,
        "after": 8,
        "note": "A Rust panic, with the message and the frames that follow it."
      },
      {
        "id": "rust_compile",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "build"
        ],
        "match": "^error\\[E\\d+\\]: |^error: (could not compile|aborting due to|linking with)",
        "end": "",
        "before": 0,
        "after": 8,
        "note": "rustc refusing to compile (`error[E0308]`). The first error is usually the cause; later ones often follow from it."
      }
    ]
  },
  {
    "group": "JVM (Maven / Gradle)",
    "packs": [
      {
        "id": "maven_gradle",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "build"
        ],
        "match": "\\[ERROR\\]",
        "end": "",
        "before": 3,
        "after": 15,
        "note": "Maven's `[ERROR]` lines \u2014 the compiler and test diagnostics Maven relays."
      },
      {
        "id": "gradle",
        "kind": "block",
        "role": "wrapper",
        "tags": [
          "build"
        ],
        "match": "^\\* What went wrong:",
        "end": "^\\* (Try|Get more help)",
        "before": 0,
        "after": 0,
        "note": "Gradle's `* What went wrong:` block, stopping before the `* Try:` boilerplate advice. A wrapper \u2014 it names the failed task, the compiler output above it is the cause."
      },
      {
        "id": "build_failure_banner",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [
          "build"
        ],
        "match": "FAILURE: Build failed|BUILD FAILURE",
        "end": "",
        "before": 3,
        "after": 15,
        "note": "The `BUILD FAILURE` / `FAILURE: Build failed` banner Maven and Gradle print once the build gave up."
      }
    ]
  },
  {
    "group": ".NET",
    "packs": [
      {
        "id": "dotnet_test",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "\\[FAIL\\]|^\\s*Failed\\s+\\S+\\s+\\[\\d|^Failed!\\s+-\\s+Failed:",
        "end": "",
        "before": 1,
        "after": 12,
        "note": "`dotnet test`: xunit/nunit `[FAIL]` markers and the `Failed!` summary line."
      },
      {
        "id": "dotnet_build",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "build"
        ],
        "match": "error (CS|MSB|NU|AD)\\d+",
        "end": "",
        "before": 1,
        "after": 3,
        "note": "MSBuild, Roslyn and NuGet error codes \u2014 `error CS0103`, `error NU1101`, `error MSB3073`."
      }
    ]
  },
  {
    "group": "Ruby",
    "packs": [
      {
        "id": "rspec",
        "kind": "block",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^Failures:$",
        "end": "^\\d+ examples?, \\d+ failures?",
        "before": 0,
        "after": 0,
        "note": "RSpec's `Failures:` block through to the `N examples, N failures` tally."
      },
      {
        "id": "minitest",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^\\s*\\d+\\) (Failure|Error):",
        "end": "",
        "before": 0,
        "after": 10,
        "note": "Minitest's numbered `1) Failure:` entries and the assertion beneath each one."
      },
      {
        "id": "ruby_exception",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "\\.rb:\\d+:in .+\\(\\w*(Error|Exception)\\)",
        "end": "",
        "before": 2,
        "after": 10,
        "note": "An unhandled Ruby exception \u2014 a backtrace frame naming the error class."
      },
      {
        "id": "bundler",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "deps"
        ],
        "match": "Could not find gem|Bundler::(GemNotFound|VersionConflict)",
        "end": "",
        "before": 1,
        "after": 6,
        "note": "Bundler failing to resolve \u2014 a missing gem, or a version conflict it prints the tree for."
      }
    ]
  },
  {
    "group": "PHP",
    "packs": [
      {
        "id": "phpunit",
        "kind": "block",
        "role": "tool",
        "tags": [
          "test"
        ],
        "match": "^There (was|were) \\d+ (failure|error)",
        "end": "^(FAILURES|ERRORS|OK)",
        "before": 0,
        "after": 0,
        "note": "PHPUnit's `There were N failures` block through to its `FAILURES`/`ERRORS`/`OK` footer."
      },
      {
        "id": "php_fatal",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "runtime"
        ],
        "match": "PHP (Fatal|Parse) error|^Fatal error:",
        "end": "",
        "before": 1,
        "after": 8,
        "note": "A PHP fatal or parse error and the stack trace after it."
      },
      {
        "id": "composer",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "deps"
        ],
        "match": "Your requirements could not be resolved",
        "end": "",
        "before": 1,
        "after": 12,
        "note": "Composer's resolver refusing the requirements, with the explanation it prints underneath."
      }
    ]
  },
  {
    "group": "C / C++",
    "packs": [
      {
        "id": "cc_cpp",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "build"
        ],
        "match": "CMake Error|undefined reference to|collect2: error",
        "end": "",
        "before": 3,
        "after": 8,
        "note": "C/C++ builds \u2014 CMake configure errors and linker `undefined reference` / `collect2` failures."
      }
    ]
  },
  {
    "group": "Language-agnostic",
    "packs": [
      {
        "id": "make",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [
          "build"
        ],
        "match": "make(\\[\\d+\\])?: \\*\\*\\* ",
        "end": "",
        "before": 3,
        "after": 8,
        "note": "`make: ***` \u2014 make reporting that a recipe it ran failed. The recipe's own output above it is the cause."
      },
      {
        "id": "bazel",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [
          "build"
        ],
        "match": "^ERROR: \\S+:\\d+:\\d+: .*(failed|FAILED)|^FAILED: Build did NOT complete|^//\\S+\\s+FAILED in \\d",
        "end": "",
        "before": 2,
        "after": 10,
        "note": "Bazel reporting that an action or target failed. A wrapper \u2014 the compiler or test output it relays is the cause."
      },
      {
        "id": "oom",
        "kind": "anchor",
        "role": "tool",
        "tags": [
          "infra"
        ],
        "match": "exit code 137|Killed|Out of memory",
        "end": "",
        "before": 5,
        "after": 2,
        "note": "The job being killed \u2014 exit code 137, `Killed`, `Out of memory`. Nothing else in the log explains a SIGKILL."
      },
      {
        "id": "generic_error",
        "kind": "anchor",
        "role": "fallback",
        "tags": [],
        "match": "^(ERROR|FATAL)\\b",
        "end": "",
        "before": 5,
        "after": 20,
        "note": "A line starting `ERROR` or `FATAL` from a tool with no pack of its own \u2014 the weakest signal; read it in context."
      }
    ]
  },
  {
    "group": "Containers",
    "packs": [
      {
        "id": "docker_build",
        "kind": "anchor",
        "role": "wrapper",
        "tags": [
          "build"
        ],
        "match": "failed to solve|executor failed running",
        "end": "",
        "before": 3,
        "after": 8,
        "note": "BuildKit giving up \u2014 `failed to solve` / `executor failed running` \u2014 around the Dockerfile step that failed. A wrapper: the `RUN` step's own output is the cause."
      }
    ]
  },
  {
    "group": "Infrastructure as code",
    "packs": [
      {
        "id": "terraform",
        "kind": "anchor",
        "role": "tool",
        "tags": [],
        "match": "^\\s*\u2502\\s*Error: |on .+\\.tf line \\d+",
        "end": "",
        "before": 1,
        "after": 12,
        "note": "Terraform's boxed `\u2502 Error:` and the `on main.tf line 12` it points at."
      }
    ]
  }
]
